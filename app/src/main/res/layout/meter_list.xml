<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FA">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:paddingStart="20dp"
            android:paddingEnd="8dp">

            <!-- App Icon + Title -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_bolt"
                    android:background="@drawable/bg_icon_yellow"
                    android:padding="8dp"
                    android:contentDescription="أيقونة التطبيق" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="عداداتي"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#1A1A2E"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tvMeterCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="لا يوجد عدادات"
                        android:textSize="12sp"
                        android:textColor="#8A8FA8" />

                </LinearLayout>
            </LinearLayout>

            <!-- Add Meter Button -->
            <ImageButton
                android:id="@+id/btnAddMeter"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_add"
                android:background="@drawable/bg_btn_circle"
                android:contentDescription="إضافة عداد"
                android:layout_gravity="center_vertical|end" />

        </androidx.appcompat.widget.Toolbar>

        <!-- Thin bottom divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EDEDF0" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main content -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Meter list (shown when meters exist) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerMeters"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:clipToPadding="false"
            android:visibility="gone" />

        <!-- Empty state (shown when no meters) -->
        <LinearLayout
            android:id="@+id/layoutEmptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="40dp"
            android:visibility="visible">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_bolt"
                android:background="@drawable/bg_empty_icon"
                android:padding="18dp"
                android:contentDescription="أيقونة فارغة"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="عداد الكهرباء"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#1A1A2E"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="أضف أول عداد لتبدأ تتبع\nاستهلاكك وفواتيرك"
                android:textSize="14sp"
                android:textColor="#8A8FA8"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="32dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddFirstMeter"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:text="+ إضافة أول عداد"
                android:textSize="15sp"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                app:cornerRadius="14dp"
                android:backgroundTint="#2563EB"
                android:textColor="#FFFFFF" />

        </LinearLayout>

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
