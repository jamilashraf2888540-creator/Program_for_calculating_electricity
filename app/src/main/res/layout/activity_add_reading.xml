<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp"
            android:layout_marginTop="8dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_arrow_back"
                android:background="@drawable/bg_btn_back"
                android:contentDescription="رجوع"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="قراءة جديدة"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A2E" />

                <TextView
                    android:id="@+id/tvMeterNameSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="بيت"
                    android:textSize="13sp"
                    android:textColor="#2563EB"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Auto-filled Previous Reading Badge -->
        <LinearLayout
            android:id="@+id/layoutPrevReadingBadge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_badge_green_card"
            android:padding="14dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_check_circle"
                android:background="@drawable/bg_icon_green_small"
                android:padding="6dp"
                android:contentDescription="محفوظ تلقائياً"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="القراءة السابقة — تلقائي"
                    android:textSize="11sp"
                    android:textColor="#059669"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:id="@+id/tvPreviousReadingValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3820 kWh"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#065F46" />

            </LinearLayout>

        </LinearLayout>

        <!-- Input Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#EDEDF0">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Current Reading -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="القراءة الحالية (kWh)"
                    android:textSize="13sp"
                    android:textColor="#5A6070"
                    android:layout_marginBottom="6dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxStrokeColor="#EDEDF0"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCurrentReading"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:hint="أدخل رقم العداد الحالي"
                        android:textSize="16sp"
                        android:textColor="#1A1A2E"
                        android:inputType="numberDecimal"
                        android:gravity="center_vertical|end" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Price per kWh -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="سعر الكيلو (₪)"
                    android:textSize="13sp"
                    android:textColor="#5A6070"
                    android:layout_marginBottom="6dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxStrokeColor="#EDEDF0"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPricePerKwh"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:hint="آخر سعر: 0.40"
                        android:textSize="16sp"
                        android:textColor="#1A1A2E"
                        android:inputType="numberDecimal"
                        android:gravity="center_vertical|end" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Date -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="التاريخ"
                    android:textSize="13sp"
                    android:textColor="#5A6070"
                    android:layout_marginBottom="6dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxStrokeColor="#EDEDF0"
                    app:endIconMode="custom"
                    app:endIconDrawable="@drawable/ic_calendar">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDate"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:textSize="15sp"
                        android:textColor="#1A1A2E"
                        android:inputType="none"
                        android:focusable="false"
                        android:clickable="true"
                        android:gravity="center_vertical|end" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Live Result Preview Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#FCD34D">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="20dp"
                android:background="#FFFBEB">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الفاتورة المحسوبة"
                    android:textSize="12sp"
                    android:textColor="#92400E"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvCalculatedCost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="— ₪"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="#B45309"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvCalculationDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="أدخل القراءة للحساب"
                    android:textSize="12sp"
                    android:textColor="#A16207" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Save Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveReading"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="حفظ القراءة"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"
            app:cornerRadius="16dp"
            android:backgroundTint="#2563EB"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
