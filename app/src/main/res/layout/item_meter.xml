<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="#EDEDF0"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <!-- Meter Icon Circle -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp">

            <ImageView
                android:id="@+id/ivMeterIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_home"
                android:background="@drawable/bg_meter_icon_blue"
                android:padding="12dp"
                android:contentDescription="أيقونة العداد" />

        </FrameLayout>

        <!-- Meter Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:id="@+id/tvMeterName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="بيت"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#1A1A2E"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvLastReading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3820 kWh"
                    android:textSize="12sp"
                    android:textColor="#8A8FA8" />

                <View
                    android:layout_width="3dp"
                    android:layout_height="3dp"
                    android:background="#CCCED8"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tvLastCost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="56.8 ₪"
                    android:textSize="12sp"
                    android:textColor="#8A8FA8" />

            </LinearLayout>

        </LinearLayout>

        <!-- Date Badge + Arrow -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/tvLastDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="اليوم"
                android:textSize="11sp"
                android:textColor="#2563EB"
                android:background="@drawable/bg_badge_blue"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:layout_marginBottom="6dp" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_chevron_left"
                android:contentDescription="فتح العداد" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
