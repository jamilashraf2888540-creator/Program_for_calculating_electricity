<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp"
            android:layout_marginTop="8dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_arrow_back"
                android:background="@drawable/bg_btn_back"
                android:contentDescription="رجوع"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="نتيجة الحساب"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A2E" />

                <TextView
                    android:id="@+id/tvMeterNameSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="بيت"
                    android:textSize="13sp"
                    android:textColor="#2563EB"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Saved badge -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="تم الحفظ"
                android:textSize="12sp"
                android:textColor="#059669"
                android:background="@drawable/bg_badge_green"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp" />

        </LinearLayout>

        <!-- Readings Comparison Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#EDEDF0">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="القراءات"
                    android:textSize="13sp"
                    android:textColor="#8A8FA8"
                    android:layout_marginBottom="14dp" />

                <!-- Two readings side by side -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <!-- Previous -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_reading_box_gray"
                        android:padding="16dp"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="السابقة"
                            android:textSize="11sp"
                            android:textColor="#8A8FA8"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            android:id="@+id/tvPreviousReading"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3820"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="#1A1A2E" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="kWh"
                            android:textSize="11sp"
                            android:textColor="#8A8FA8"
                            android:layout_marginTop="2dp" />

                    </LinearLayout>

                    <!-- Arrow between -->
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_arrow_left"
                        android:contentDescription="من السابقة إلى الحالية"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp" />

                    <!-- Current -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_reading_box_blue"
                        android:padding="16dp"
                        android:layout_marginStart="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="الحالية"
                            android:textSize="11sp"
                            android:textColor="#2563EB"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            android:id="@+id/tvCurrentReading"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3975"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="#1E40AF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="kWh"
                            android:textSize="11sp"
                            android:textColor="#3B82F6"
                            android:layout_marginTop="2dp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Stats Row: Consumption + Price -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <!-- Consumption -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#EDEDF0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="الاستهلاك"
                        android:textSize="11sp"
                        android:textColor="#8A8FA8"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/tvConsumption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="155"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="#1A1A2E" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="kWh"
                        android:textSize="11sp"
                        android:textColor="#8A8FA8"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Price per kWh -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#EDEDF0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="سعر الكيلو"
                        android:textSize="11sp"
                        android:textColor="#8A8FA8"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/tvPricePerKwh"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.40"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="#1A1A2E" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₪ / kWh"
                        android:textSize="11sp"
                        android:textColor="#8A8FA8"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Total Bill — Hero Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#FCD34D">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp"
                android:background="#FFFBEB">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="إجمالي الفاتورة"
                    android:textSize="13sp"
                    android:textColor="#92400E"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvTotalBill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="62.00 ₪"
                    android:textSize="40sp"
                    android:textStyle="bold"
                    android:textColor="#B45309"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvBillFormula"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="155 kWh × 0.40 ₪"
                    android:textSize="13sp"
                    android:textColor="#A16207" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Action Buttons -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackToMeters"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="رجوع للعدادات"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"
            app:cornerRadius="16dp"
            android:backgroundTint="#2563EB"
            android:textColor="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddAnotherReading"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="إضافة قراءة أخرى"
            android:textSize="15sp"
            android:layout_marginBottom="24dp"
            app:cornerRadius="16dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:strokeColor="#EDEDF0"
            android:textColor="#5A6070" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
